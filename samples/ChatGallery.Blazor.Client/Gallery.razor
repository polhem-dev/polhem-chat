@using Microsoft.AspNetCore.Components.Routing

@* The chat view with a runner over the scripted client: attachments on, suggestions, the activity toggle bound, and the
   application's own content in the header and under the prompt box. The same component runs on the server and in the
   browser; the header says where it runs now. *@
<div class="gallery">
    <nav class="modes">
        <NavLink href="" Match="NavLinkMatch.All">Interactive Server</NavLink>
        <NavLink href="wasm">WebAssembly</NavLink>
    </nav>
    <div class="frame">
        <ChatView Runner="_runner" AllowsAttachments="true" Suggestions="s_suggestions" @bind-ShowsActivity="_showsActivity">
            <HeaderContent>
                <h1 class="title">Polhem.Chat.Blazor <span class="where">running on @Where</span></h1>
            </HeaderContent>
            <PromptFooterContent>
                <small class="note">Scripted replies: no model is called and nothing leaves the page.</small>
            </PromptFooterContent>
        </ChatView>
    </div>
</div>

@code {
    private static readonly string[] s_suggestions =
        ["Plan three days in Kyoto", "Give me a long reply", "Show me an error", "Delete my old notes", "規劃京都三日遊"];

    private readonly ChatRunner _runner = CreateRunner();
    private bool _showsActivity;

    // Static while the page prerenders, then Server or WebAssembly.
    private string Where => RendererInfo.Name switch
    {
        "Server" => "the server",
        "WebAssembly" => "WebAssembly, in the browser",
        _ => "the server, prerendered",
    };

    // NOTE: A real application keeps its model client on the server; see the README. The scripted client needs no key,
    // so this gallery may run it in the browser too.
    private static ChatRunner CreateRunner()
    {
        var runner = new ChatRunner(DemoTools.WithTools(new DemoChatClient())) { Options = DemoTools.Options };
        runner.Conversation.DescribeToolCall = ToolTitles.Describe;
        return runner;
    }
}

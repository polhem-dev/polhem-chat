<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The gallery on Android, to check the control under the SDK's default trim: compiled bindings, the Traditional
    Chinese satellite assembly and the Markdown viewer. It is not in the solution, because CI builds without the
    Android workload; build it as the README shows. Trim warnings from the dependencies are expected here, so this head
    does not treat warnings as errors.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>23</SupportedOSPlatformVersion>
    <ApplicationId>com.polhem.chat.gallery</ApplicationId>
    <ApplicationTitle>Chat Gallery</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Android" Version="12.1.6" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.6" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ChatGallery\ChatGallery.csproj" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <Description>An AI chat component for Blazor, Server and WebAssembly: streamed replies rendered as Markdown, reasoning, tool calls and their approval, per-turn usage, stop, copy and attachments, on top of any Microsoft.Extensions.AI IChatClient.</Description>
    <!-- The component runs on WebAssembly, where the application is trimmed. The trim and AOT analyzers turn every
         incompatible call into a build error. -->
    <IsAotCompatible>true</IsAotCompatible>
    <PackageTags>$(PackageTags);blazor</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <!-- The lowest versions the component supports, not the newest: they become the minimum for every consumer.
         Polhem.Markdown.Blazor 0.5.0 takes the same Polhem.Markdown as Polhem.Markdown.Avalonia 0.5.0, which the Avalonia
         control uses: Polhem.Markdown is pinned to an exact version, so the two front ends must agree on it. -->
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.1" />
    <PackageReference Include="Polhem.Markdown.Blazor" Version="0.5.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Polhem.Chat.Blazor.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Polhem.Chat\Polhem.Chat.csproj" />
  </ItemGroup>

</Project>

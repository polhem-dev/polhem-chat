<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Polhem.Chat.Avalonia"
        xmlns:ai="using:Microsoft.Extensions.AI"
        x:Class="Polhem.Chat.Avalonia.ChatTheme">

  <Styles.Resources>
    <ResourceDictionary>
      <!-- NOTE: The colors are translucent so that they sit on any base theme: Fluent and Semi, light and dark, draw
           their own background and text color, and these only tint it. An application changes one by declaring the
           same key in its own resources. -->
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="PolhemChatPromptBackground" Color="#263B82F6" />
          <SolidColorBrush x:Key="PolhemChatCardBackground" Color="#08000000" />
          <SolidColorBrush x:Key="PolhemChatCardBorderBrush" Color="#1F000000" />
          <!-- Nearly opaque: the jump button floats over the text. -->
          <SolidColorBrush x:Key="PolhemChatScrollButtonBackground" Color="#F2FFFFFF" />
          <SolidColorBrush x:Key="PolhemChatScrollButtonDotBrush" Color="#D97757" />
          <SolidColorBrush x:Key="PolhemChatErrorBackground" Color="#14DC2626" />
          <SolidColorBrush x:Key="PolhemChatErrorBorderBrush" Color="#66DC2626" />
          <SolidColorBrush x:Key="PolhemChatErrorForeground" Color="#B91C1C" />
          <!-- The composer card lifts a little off the conversation. -->
          <SolidColorBrush x:Key="PolhemChatComposerBackground" Color="#CCFFFFFF" />
          <SolidColorBrush x:Key="PolhemChatComposerFocusBorderBrush" Color="#803B82F6" />
          <SolidColorBrush x:Key="PolhemChatSendBackground" Color="#E6000000" />
          <SolidColorBrush x:Key="PolhemChatSendForeground" Color="#FFFFFFFF" />
          <SolidColorBrush x:Key="PolhemChatComposerButtonHoverBackground" Color="#14000000" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="PolhemChatPromptBackground" Color="#4D3B82F6" />
          <SolidColorBrush x:Key="PolhemChatCardBackground" Color="#0FFFFFFF" />
          <SolidColorBrush x:Key="PolhemChatCardBorderBrush" Color="#29FFFFFF" />
          <SolidColorBrush x:Key="PolhemChatScrollButtonBackground" Color="#F22B2B2B" />
          <SolidColorBrush x:Key="PolhemChatScrollButtonDotBrush" Color="#E08A6E" />
          <SolidColorBrush x:Key="PolhemChatErrorBackground" Color="#29F87171" />
          <SolidColorBrush x:Key="PolhemChatErrorBorderBrush" Color="#80F87171" />
          <SolidColorBrush x:Key="PolhemChatErrorForeground" Color="#FCA5A5" />
          <SolidColorBrush x:Key="PolhemChatComposerBackground" Color="#14FFFFFF" />
          <SolidColorBrush x:Key="PolhemChatComposerFocusBorderBrush" Color="#993B82F6" />
          <SolidColorBrush x:Key="PolhemChatSendBackground" Color="#F2FFFFFF" />
          <SolidColorBrush x:Key="PolhemChatSendForeground" Color="#FF1F1F1F" />
          <SolidColorBrush x:Key="PolhemChatComposerButtonHoverBackground" Color="#1FFFFFFF" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>

      <ControlTheme x:Key="{x:Type local:ChatView}" TargetType="local:ChatView">
        <Setter Property="Template">
          <ControlTemplate>
            <!-- The view's own frame: none by default; BorderBrush, BorderThickness and CornerRadius draw one, and the
                 content is clipped to the rounded corners. -->
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    ClipToBounds="True">
              <Grid RowDefinitions="Auto,*,Auto">
                <!-- The application's own content above the conversation (ChatView.HeaderContent); it does not scroll. -->
                <ContentPresenter Name="PART_Header"
                                  Content="{TemplateBinding HeaderContent}"
                                  ContentTemplate="{TemplateBinding HeaderContentTemplate}"
                                  IsVisible="{TemplateBinding HeaderContent, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <ScrollViewer Name="PART_ScrollViewer" Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
                  <StackPanel Margin="16,12" Spacing="12">
                    <ItemsControl Name="PART_Entries">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Spacing="12" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <!-- While a reply is in progress: what the model is doing (Thinking, or the running tool's title) when no
                         entry shows it, then the request the turn is on, its seconds and its output tokens, which the view
                         keeps current. -->
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <!-- The animated icon (ChatView.ActivityIcon) plays here while a reply is in progress. -->
                      <Border Name="PART_Spinner"
                              Width="16"
                              Height="16"
                              VerticalAlignment="Center"
                              IsVisible="False" />
                      <TextBlock Name="PART_Waiting"
                                 Classes="polhemChatThinking"
                                 VerticalAlignment="Center"
                                 Opacity="0.75"
                                 IsVisible="False" />
                      <TextBlock Name="PART_Progress"
                                 Classes="polhemChatProgress"
                                 VerticalAlignment="Center"
                                 Opacity="0.6"
                                 IsVisible="False" />
                      <!-- Opens and closes the reasoning and the tool calls, which the conversation leaves out by default. -->
                      <ToggleButton Name="PART_ActivityToggle"
                                    Classes="polhemChatActivityToggle"
                                    VerticalAlignment="Center"
                                    Padding="4,0"
                                    Opacity="0.6"
                                    IsVisible="False"
                                    IsChecked="{Binding $parent[local:ChatView].ShowsActivity, Mode=TwoWay}"
                                    ToolTip.Tip="{Binding $parent[local:ChatView].Strings.ShowActivity}"
                                    AutomationProperties.Name="{Binding $parent[local:ChatView].Strings.ShowActivity}"
                                    Content="›"
                                    Cursor="Hand"
                                    RenderTransformOrigin="50%,50%">
                        <!-- A glyph, not a button: no fill from the base theme when checked or hovered. -->
                        <ToggleButton.Theme>
                          <ControlTheme TargetType="ToggleButton">
                            <Setter Property="Template">
                              <ControlTemplate>
                                <ContentPresenter Background="Transparent"
                                                  Padding="{TemplateBinding Padding}"
                                                  Content="{TemplateBinding Content}" />
                              </ControlTemplate>
                            </Setter>
                          </ControlTheme>
                        </ToggleButton.Theme>
                      </ToggleButton>
                    </StackPanel>
                  </StackPanel>
                </ScrollViewer>

                <StackPanel Name="PART_EmptyState"
                            Grid.Row="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="24"
                            Spacing="16"
                            IsVisible="False">
                  <Panel HorizontalAlignment="Center">
                    <TextBlock Name="PART_EmptyTitle"
                               Text="{Binding $parent[local:ChatView].Strings.EmptyTitle}"
                               FontSize="18"
                               IsVisible="{TemplateBinding EmptyContent, Converter={x:Static ObjectConverters.IsNull}}" />
                    <ContentPresenter Content="{TemplateBinding EmptyContent}"
                                      ContentTemplate="{TemplateBinding EmptyContentTemplate}" />
                  </Panel>
                  <ItemsControl Name="PART_Suggestions" ItemsSource="{TemplateBinding Suggestions}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="x:String">
                        <Button Classes="polhemChatSuggestion"
                                Margin="4"
                                Content="{Binding}"
                                Command="{Binding $parent[local:ChatView].SubmitCommand}"
                                CommandParameter="{Binding}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>

                <!-- A round button with an arrow down, or three pulsing dots while a reply is in progress, so it shows that
                     new text is arriving below. The text stays for the tooltip and screen readers. -->
                <Button Name="PART_ScrollToLatest"
                        Classes="polhemChatScrollToLatest"
                        Grid.Row="1"
                        Width="36"
                        Height="36"
                        Padding="0"
                        CornerRadius="18"
                        BorderThickness="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Margin="0,0,0,12"
                        IsVisible="False"
                        ToolTip.Tip="{Binding $parent[local:ChatView].Strings.JumpToLatest}"
                        AutomationProperties.Name="{Binding $parent[local:ChatView].Strings.JumpToLatest}"
                        Command="{Binding $parent[local:ChatView].ScrollToLatestCommand}">
                  <Panel>
                    <PathIcon Name="PART_ScrollToLatestArrow"
                              Width="14"
                              Height="14"
                              Data="M11 4h2v12.17l5.59-5.58L20 12l-8 8-8-8 1.41-1.41L11 16.17V4z" />
                    <StackPanel Name="PART_ScrollToLatestDots"
                                Orientation="Horizontal"
                                Spacing="3"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsVisible="False">
                      <Ellipse Classes="polhemChatJumpDot first" />
                      <Ellipse Classes="polhemChatJumpDot second" />
                      <Ellipse Classes="polhemChatJumpDot third" />
                    </StackPanel>
                  </Panel>
                </Button>

                <!-- The composer sits in the conversation, with no line between them: one rounded card holds the attached
                     files, the prompt box and its buttons. What the application adds, the edit banner and errors stay
                     outside the card. -->
                <StackPanel Grid.Row="2" Margin="16,4,16,12" Spacing="6">
                  <!-- The application's own content above and below the prompt box (ChatView.PromptHeaderContent and
                       PromptFooterContent). -->
                  <!-- While the box holds the last prompt to change (ChatView.IsEditingPrompt). -->
                  <Border Name="PART_EditBanner"
                          Classes="polhemChatEditBanner"
                          Padding="8,4"
                          CornerRadius="6"
                          IsVisible="False"
                          Background="{DynamicResource PolhemChatPromptBackground}">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock VerticalAlignment="Center"
                                 FontSize="12"
                                 Text="{Binding $parent[local:ChatView].Strings.EditingPrompt}" />
                      <Button Grid.Column="1"
                              Classes="polhemChatCancelEdit"
                              Padding="6,2"
                              FontSize="12"
                              Content="{Binding $parent[local:ChatView].Strings.CancelEdit}"
                              Command="{Binding $parent[local:ChatView].CancelEditCommand}" />
                    </Grid>
                  </Border>
                  <ContentPresenter Name="PART_PromptHeader"
                                    Content="{TemplateBinding PromptHeaderContent}"
                                    ContentTemplate="{TemplateBinding PromptHeaderContentTemplate}"
                                    IsVisible="{TemplateBinding PromptHeaderContent, Converter={x:Static ObjectConverters.IsNotNull}}" />
                  <Border Name="PART_Composer"
                          Classes="polhemChatComposer"
                          Padding="6"
                          CornerRadius="14"
                          BorderThickness="1"
                          Background="{DynamicResource PolhemChatComposerBackground}"
                          BorderBrush="{DynamicResource PolhemChatCardBorderBrush}">
                    <StackPanel Spacing="6">
                      <!-- The files attached to the prompt (ChatView.PendingAttachments): a picture or a document icon, the
                           name with hidden characters escaped, the size, and a button that removes it. -->
                      <ItemsControl Name="PART_Attachments"
                                    Margin="4,2,4,0"
                                    ItemsSource="{Binding $parent[local:ChatView].PendingAttachments}"
                                    IsVisible="{Binding $parent[local:ChatView].PendingAttachments.Count, Converter={x:Static local:EntryConverters.IsPositive}}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <WrapPanel ItemSpacing="6" LineSpacing="6" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="ai:DataContent">
                            <Border Classes="polhemChatAttachment"
                                    Padding="4,4,2,4"
                                    CornerRadius="8"
                                    BorderThickness="1"
                                    Background="{DynamicResource PolhemChatCardBackground}"
                                    BorderBrush="{DynamicResource PolhemChatCardBorderBrush}">
                              <StackPanel Orientation="Horizontal" Spacing="6">
                                <Image Width="28"
                                       Height="28"
                                       Stretch="UniformToFill"
                                       Source="{Binding Converter={x:Static local:EntryConverters.Thumbnail}}"
                                       IsVisible="{Binding $self.Source, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                <PathIcon Width="16"
                                          Height="16"
                                          Margin="6,0"
                                          IsVisible="{Binding Converter={x:Static local:EntryConverters.IsDocument}}"
                                          Data="M6 2h8l6 6v12a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2zm7 1.5V9h5.5L13 3.5z" />
                                <StackPanel VerticalAlignment="Center">
                                  <TextBlock Text="{Binding Name, Converter={x:Static local:EntryConverters.Visible}}"
                                             MaxWidth="180"
                                             TextTrimming="CharacterEllipsis"
                                             FontSize="12" />
                                  <TextBlock FontSize="11" Opacity="0.6">
                                    <TextBlock.Text>
                                      <MultiBinding Converter="{x:Static local:EntryConverters.FileSize}">
                                        <Binding />
                                        <Binding Path="$parent[local:ChatView].Strings" />
                                      </MultiBinding>
                                    </TextBlock.Text>
                                  </TextBlock>
                                </StackPanel>
                                <Button Classes="polhemChatRemoveAttachment"
                                        Padding="4"
                                        VerticalAlignment="Center"
                                        Background="Transparent"
                                        ToolTip.Tip="{Binding $parent[local:ChatView].Strings.RemoveAttachment}"
                                        AutomationProperties.Name="{Binding $parent[local:ChatView].Strings.RemoveAttachment}"
                                        Command="{Binding $parent[local:ChatView].RemoveAttachmentCommand}"
                                        CommandParameter="{Binding}">
                                  <PathIcon Width="10" Height="10" Data="M4 4l16 16M20 4L4 20" />
                                </Button>
                              </StackPanel>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <Grid ColumnDefinitions="Auto,*,Auto">
                        <Button Name="PART_AttachButton"
                                Classes="polhemChatComposerButton"
                                Margin="0,0,4,0"
                                VerticalAlignment="Bottom"
                                IsVisible="{Binding $parent[local:ChatView].AllowsAttachments}"
                                ToolTip.Tip="{Binding $parent[local:ChatView].Strings.Attach}"
                                AutomationProperties.Name="{Binding $parent[local:ChatView].Strings.Attach}"
                                Command="{Binding $parent[local:ChatView].AttachCommand}">
                          <PathIcon Width="14" Height="14" Data="M11 4h2v7h7v2h-7v7h-2v-7H4v-2h7z" />
                        </Button>
                        <local:ChatPromptBox Name="PART_PromptBox"
                                             Classes="polhemChatComposerInput"
                                             Grid.Column="1"
                                             MinHeight="32"
                                             MaxHeight="160"
                                             VerticalContentAlignment="Center"
                                             Text="{TemplateBinding Prompt, Mode=TwoWay}"
                                             PlaceholderText="{Binding $parent[local:ChatView].Strings.PromptPlaceholder}" />
                        <!-- Icons, not words: the text is the tooltip and what a screen reader says. -->
                        <Panel Grid.Column="2" Margin="4,0,0,0" VerticalAlignment="Bottom">
                          <Button Name="PART_SendButton"
                                  Classes="polhemChatComposerButton polhemChatSend"
                                  ToolTip.Tip="{Binding $parent[local:ChatView].Strings.Send}"
                                  AutomationProperties.Name="{Binding $parent[local:ChatView].Strings.Send}"
                                  Command="{Binding $parent[local:ChatView].SubmitCommand}">
                            <PathIcon Width="14" Height="14" Data="M11 20V7.83l-5.59 5.59L4 12l8-8 8 8-1.41 1.41L13 7.83V20z" />
                          </Button>
                          <Button Name="PART_StopButton"
                                  Classes="polhemChatComposerButton polhemChatStop"
                                  IsVisible="False"
                                  ToolTip.Tip="{Binding $parent[local:ChatView].Strings.Stop}"
                                  AutomationProperties.Name="{Binding $parent[local:ChatView].Strings.Stop}"
                                  Command="{Binding $parent[local:ChatView].StopCommand}">
                            <Rectangle Width="12" Height="12" RadiusX="2" RadiusY="2" Fill="{Binding $parent[Button].Foreground}" />
                          </Button>
                        </Panel>
                      </Grid>
                    </StackPanel>
                  </Border>
                  <!-- Why the last file was not attached; the view fills and clears it. -->
                  <TextBlock Name="PART_AttachmentError"
                             Classes="polhemChatAttachmentError"
                             Margin="4,0"
                             FontSize="12"
                             TextWrapping="Wrap"
                             IsVisible="False"
                             Foreground="{DynamicResource PolhemChatErrorForeground}" />
                  <ContentPresenter Name="PART_PromptFooter"
                                    Content="{TemplateBinding PromptFooterContent}"
                                    ContentTemplate="{TemplateBinding PromptFooterContentTemplate}"
                                    IsVisible="{TemplateBinding PromptFooterContent, Converter={x:Static ObjectConverters.IsNotNull}}" />
                </StackPanel>
              </Grid>
            </Border>
          </ControlTemplate>
        </Setter>

        <Style Selector="^ /template/ Border#PART_Composer">
          <Setter Property="Effect">
            <DropShadowEffect OffsetX="0" OffsetY="1" BlurRadius="6" Opacity="0.08" />
          </Setter>
        </Style>
        <Style Selector="^ /template/ Border#PART_Composer:focus-within">
          <Setter Property="BorderBrush" Value="{DynamicResource PolhemChatComposerFocusBorderBrush}" />
        </Style>
        <Style Selector="^:editing /template/ Border#PART_EditBanner">
          <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:empty /template/ StackPanel#PART_EmptyState">
          <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:scrolledup /template/ Button#PART_ScrollToLatest">
          <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^ /template/ Button#PART_ScrollToLatest">
          <Setter Property="Background" Value="{DynamicResource PolhemChatScrollButtonBackground}" />
          <Setter Property="BorderBrush" Value="{DynamicResource PolhemChatCardBorderBrush}" />
          <!-- An effect, not a BoxShadow: a Button's border is part of each base theme's own template. -->
          <Setter Property="Effect">
            <DropShadowEffect OffsetX="0" OffsetY="2" BlurRadius="8" Opacity="0.18" />
          </Setter>
        </Style>
        <Style Selector="^ /template/ Ellipse.polhemChatJumpDot">
          <Setter Property="Width" Value="5" />
          <Setter Property="Height" Value="5" />
          <Setter Property="Fill" Value="{DynamicResource PolhemChatScrollButtonDotBrush}" />
          <Setter Property="Opacity" Value="0.35" />
        </Style>
        <!-- The dots pulse one after the other, and only while they show. -->
        <Style Selector="^:generating:scrolledup /template/ Ellipse.polhemChatJumpDot">
          <Style.Animations>
            <Animation Duration="0:0:1.2" IterationCount="INFINITE">
              <KeyFrame Cue="0%">
                <Setter Property="Opacity" Value="0.35" />
              </KeyFrame>
              <KeyFrame Cue="30%">
                <Setter Property="Opacity" Value="1" />
              </KeyFrame>
              <KeyFrame Cue="60%">
                <Setter Property="Opacity" Value="0.35" />
              </KeyFrame>
              <KeyFrame Cue="100%">
                <Setter Property="Opacity" Value="0.35" />
              </KeyFrame>
            </Animation>
          </Style.Animations>
        </Style>
        <Style Selector="^:generating:scrolledup /template/ Ellipse.polhemChatJumpDot.second">
          <Style.Animations>
            <Animation Duration="0:0:1.2" Delay="0:0:0.2" IterationCount="INFINITE">
              <KeyFrame Cue="0%">
                <Setter Property="Opacity" Value="0.35" />
              </KeyFrame>
              <KeyFrame Cue="30%">
                <Setter Property="Opacity" Value="1" />
              </KeyFrame>
              <KeyFrame Cue="60%">
                <Setter Property="Opacity" Value="0.35" />
              </KeyFrame>
              <KeyFrame Cue="100%">
                <Setter Property="Opacity" Value="0.35" />
              </KeyFrame>
            </Animation>
          </Style.Animations>
        </Style>
        <Style Selector="^:generating:scrolledup /template/ Ellipse.polhemChatJumpDot.third">
          <Style.Animations>
            <Animation Duration="0:0:1.2" Delay="0:0:0.4" IterationCount="INFINITE">
              <KeyFrame Cue="0%">
                <Setter Property="Opacity" Value="0.35" />
              </KeyFrame>
              <KeyFrame Cue="30%">
                <Setter Property="Opacity" Value="1" />
              </KeyFrame>
              <KeyFrame Cue="60%">
                <Setter Property="Opacity" Value="0.35" />
              </KeyFrame>
              <KeyFrame Cue="100%">
                <Setter Property="Opacity" Value="0.35" />
              </KeyFrame>
            </Animation>
          </Style.Animations>
        </Style>
        <Style Selector="^:generating /template/ PathIcon#PART_ScrollToLatestArrow">
          <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^:generating /template/ StackPanel#PART_ScrollToLatestDots">
          <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:generating /template/ Border#PART_Spinner">
          <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:generating /template/ ToggleButton#PART_ActivityToggle">
          <Setter Property="IsVisible" Value="True" />
        </Style>
        <!-- Open, the toggle stays after the turn, so the details can be closed again. -->
        <Style Selector="^ /template/ ToggleButton#PART_ActivityToggle:checked">
          <Setter Property="IsVisible" Value="True" />
          <Setter Property="RenderTransform" Value="rotate(90deg)" />
        </Style>
        <Style Selector="^:waiting /template/ TextBlock#PART_Waiting">
          <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:generating /template/ Button#PART_SendButton">
          <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^:generating /template/ Button#PART_StopButton">
          <Setter Property="IsVisible" Value="True" />
        </Style>
      </ControlTheme>
    </ResourceDictionary>
  </Styles.Resources>

  <!-- NOTE: The prompt box and the composer's buttons keep the base theme's templates; these styles only clear the
       parts of them that would draw a second frame inside the card. Styles outrank a control theme's own setters,
       including its :focus and :pointerover ones, so the box stays flat in every state. -->
  <!-- NOTE: The prompt box styles as a TextBox (its StyleKeyOverride), so a selector names TextBox, not ChatPromptBox. -->
  <Style Selector="TextBox.polhemChatComposerInput">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="6,6" />
  </Style>
  <Style Selector="TextBox.polhemChatComposerInput /template/ Border">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.polhemChatComposerButton">
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.polhemChatComposerButton /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.polhemChatComposerButton:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PolhemChatComposerButtonHoverBackground}" />
  </Style>
  <!-- The base theme colors the presenter in each state, disabled included, so the arrow takes its color itself. -->
  <Style Selector="Button.polhemChatSend PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource PolhemChatSendForeground}" />
  </Style>
  <Style Selector="Button.polhemChatSend /template/ ContentPresenter, Button.polhemChatSend:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PolhemChatSendBackground}" />
  </Style>
  <Style Selector="Button.polhemChatSend:pointerover">
    <Setter Property="Opacity" Value="0.85" />
  </Style>
  <Style Selector="Button.polhemChatSend:disabled">
    <Setter Property="Opacity" Value="0.35" />
  </Style>

  <!-- The copy button of a reply is an icon that fades in while the pointer is over the reply, or it has the keyboard
       focus; it keeps its place, so the conversation does not move. -->
  <Style Selector="Button.polhemChatCopy">
    <Setter Property="Padding" Value="4" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Opacity" Value="0" />
  </Style>
  <Style Selector="StackPanel.polhemChatReply:pointerover Button.polhemChatCopy, Button.polhemChatCopy:focus-visible">
    <Setter Property="Opacity" Value="0.7" />
  </Style>

  <!-- The regenerate and edit buttons look and fade in like the copy button. -->
  <Style Selector="Button.polhemChatRegenerate, Button.polhemChatEdit">
    <Setter Property="Padding" Value="4" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Opacity" Value="0" />
  </Style>
  <Style Selector="StackPanel.polhemChatReply:pointerover Button.polhemChatRegenerate, Border.polhemChatPrompt:pointerover Button.polhemChatEdit, Button.polhemChatRegenerate:focus-visible, Button.polhemChatEdit:focus-visible">
    <Setter Property="Opacity" Value="0.7" />
  </Style>

</Styles>
